import type { Meta, Routes } from "@minimajs/server";
import * as handlers from "./{{ name }}.handler.js";

export const meta: Meta = {
  plugins: [],
};

export const routes: Routes = {
  "GET /": handlers.list,
  "GET /:{{ singular }}": handlers.get,
  "POST /": handlers.create,
  "PUT /:{{ singular }}": handlers.update,
  "DELETE /:{{ singular }}": handlers.remove,
};
