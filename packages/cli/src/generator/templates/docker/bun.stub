# ── Base stage ─────────────────────────────────────────────────────────────────
FROM oven/bun:{{ version }} AS base

WORKDIR /app

COPY package.json bun.lock* ./

# ── Builder stage ───────────────────────────────────────────────────────────────
FROM base AS builder
RUN bun install --frozen-lockfile

COPY . .
RUN bun run build

# ── Runner stage ────────────────────────────────────────────────────────────────
FROM base AS runner
RUN {{ userCreate }}

ENV NODE_ENV=production

RUN --mount=type=bind,from=builder,source=/root/.bun/install/cache,target=/tmp/bun-cache \
    BUN_INSTALL_CACHE_DIR=/tmp/bun-cache bun install --frozen-lockfile --production

COPY --chown={{ user }}:{{ user }} --from=builder /app/dist ./dist

USER {{ user }}

ENV PORT={{ port }}
EXPOSE {{ port }}

CMD ["bun", "run", "start"]
