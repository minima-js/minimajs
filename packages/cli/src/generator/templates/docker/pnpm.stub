# ── Base stage ─────────────────────────────────────────────────────────────────
FROM node:{{ version }} AS base

RUN npm i -g corepack --force && corepack enable

WORKDIR /app

COPY package.json pnpm-lock.yaml ./

RUN pnpm -v

# ── Builder stage ───────────────────────────────────────────────────────────────
FROM base AS builder
RUN pnpm install --frozen-lockfile --store-dir /root/.cache/pnpm

COPY . .
RUN pnpm run build

# ── Runner stage ────────────────────────────────────────────────────────────────
FROM base AS runner
RUN {{ userCreate }}

ENV NODE_ENV=production

RUN --mount=type=bind,from=builder,source=/root/.cache/pnpm,target=/root/.cache/pnpm \
    pnpm install --frozen-lockfile --prod --store-dir /root/.cache/pnpm

COPY --chown={{ user }}:{{ user }} --from=builder /app/dist ./dist

USER {{ user }}

ENV PORT={{ port }}
EXPOSE {{ port }}

CMD ["pnpm", "run", "start"]
