# ── Base stage ─────────────────────────────────────────────────────────────────
FROM node:{{ version }} AS base

ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN npm i -g corepack --force && corepack enable

WORKDIR /app

COPY package.json pnpm-lock.yaml ./

# ── Builder stage ───────────────────────────────────────────────────────────────
FROM base AS builder
RUN pnpm install --frozen-lockfile --store-dir /pnpm/store

COPY . .
RUN pnpm run build

# ── Runner stage ────────────────────────────────────────────────────────────────
FROM base AS runner
RUN {{ userCreate }}

ENV NODE_ENV=production

RUN --mount=type=bind,from=builder,source=/pnpm/store,target=/pnpm/store \
    pnpm install --frozen-lockfile --prod --store-dir /pnpm/store

COPY --chown={{ user }}:{{ user }} --from=builder /app/dist ./dist

USER {{ user }}

ENV PORT={{ port }}
EXPOSE {{ port }}

CMD ["pnpm", "run", "start"]
