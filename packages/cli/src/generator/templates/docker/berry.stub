# ── Base stage ─────────────────────────────────────────────────────────────────
FROM node:{{ version }} AS base
RUN npm i -g corepack --force && corepack enable

WORKDIR /app

COPY package.json yarn.lock ./
COPY .yarn ./.yarn

RUN yarn -v

# ── Builder stage ───────────────────────────────────────────────────────────────
FROM base AS builder
RUN yarn install --immutable

COPY . .
RUN yarn build

# ── Runner stage ────────────────────────────────────────────────────────────────
FROM base AS runner
RUN {{ userCreate }}

ENV NODE_ENV=production

RUN --mount=type=bind,from=builder,source=/root/.yarn/berry/cache,target=/tmp/yarn-cache \
    YARN_CACHE_FOLDER=/tmp/yarn-cache yarn workspaces focus --all --production

COPY --chown={{ user }}:{{ user }} --from=builder /app/dist ./dist

USER {{ user }}

ENV PORT={{ port }}
EXPOSE {{ port }}

CMD ["yarn", "run", "start"]
