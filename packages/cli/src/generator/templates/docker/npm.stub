# ── Base stage ─────────────────────────────────────────────────────────────────
FROM node:{{ version }} AS base

WORKDIR /app

COPY package*.json ./

# ── Builder stage ───────────────────────────────────────────────────────────────
FROM base AS builder
RUN npm ci

COPY . .
RUN npm run build

# ── Runner stage ────────────────────────────────────────────────────────────────
FROM base AS runner
RUN {{ userCreate }}

ENV NODE_ENV=production

RUN --mount=type=bind,from=builder,source=/root/.npm,target=/tmp/npm-cache \
    npm ci --omit=dev --cache /tmp/npm-cache

COPY --chown={{ user }}:{{ user }} --from=builder /app/dist ./dist

USER {{ user }}

ENV PORT={{ port }}
EXPOSE {{ port }}

CMD ["npm", "run", "start"]
