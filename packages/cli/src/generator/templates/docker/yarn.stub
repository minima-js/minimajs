# ── Base stage ─────────────────────────────────────────────────────────────────
FROM node:{{ version }} AS base

WORKDIR /app

COPY package.json yarn.lock ./

# ── Builder stage ───────────────────────────────────────────────────────────────
FROM base AS builder
RUN yarn install --frozen-lockfile

COPY . .
RUN yarn build

# ── Runner stage ────────────────────────────────────────────────────────────────
FROM base AS runner
RUN {{ userCreate }}

ENV NODE_ENV=production

RUN --mount=type=bind,from=builder,source=/root/.cache/yarn,target=/tmp/yarn-cache \
    YARN_CACHE_FOLDER=/tmp/yarn-cache yarn install --frozen-lockfile --production

COPY --chown={{ user }}:{{ user }} --from=builder /app/dist ./dist

USER {{ user }}

ENV PORT={{ port }}
EXPOSE {{ port }}

CMD ["yarn", "run", "start"]
